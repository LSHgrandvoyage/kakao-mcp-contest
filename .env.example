# ── Lease Guide ingest 설정 ──
# 이 파일을 복사해 .env 로 만들고 값을 채운다:  cp .env.example .env
# .env 는 .gitignore 로 커밋 제외됨. serviceKey 는 ingest 배치에서만 쓰이며 런타임 서버는 모른다.

# 국토부 실거래가 API 인증키.
# data.go.kr > 마이페이지 > 오픈API > 인증키 의 [Encoding] 값을 그대로 붙여넣는다.
# (Encoding 키를 넣어야 이중 인코딩 문제가 안 생긴다)
MOLIT_SERVICE_KEY=여기에_Encoding_인증키_붙여넣기

# (선택) 대상 시군구 법정동코드. 기본값 강남구.
LAWD_CD=11680

# (선택) 적재할 최근 개월 수. 기본값 6.
MONTHS=6
